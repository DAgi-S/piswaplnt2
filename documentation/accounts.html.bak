            <!-- Main Content -->
            <div class="col-md-10 content">
                <h1>Accounts Management System Documentation <span class="version-tag">v1.0.0</span></h1>
                
                <section id="overview">
                    <h2>Overview</h2>
                    <p>The Accounts Management System is a comprehensive solution for managing digital platform accounts, including account creation, balance tracking, and transaction history. It provides functionality for creating, viewing, updating, and deleting account records, with integrated balance management and account type classification.</p>
                    
                    <h4>Key Features</h4>
                    <ul>
                        <li>Account creation and management</li>
                        <li>Real-time balance tracking</li>
                        <li>Transaction history</li>
                        <li>Account type classification</li>
                        <li>Balance updates and reconciliation</li>
                        <li>Detailed reporting and analytics</li>
                    </ul>
                </section>

                <section id="requirements">
                    <h2>System Requirements</h2>
                    <h4>Server Requirements</h4>
                    <ul>
                        <li>PHP 7.4 or higher</li>
                        <li>MySQL 5.7 or higher</li>
                        <li>Apache/Nginx web server</li>
                        <li>mod_rewrite enabled</li>
                    </ul>

                    <h4>Client Requirements</h4>
                    <ul>
                        <li>Modern web browser (Chrome, Firefox, Safari, Edge)</li>
                        <li>JavaScript enabled</li>
                        <li>Minimum screen resolution: 1024x768</li>
                    </ul>
                </section>

                <section id="installation">
                    <h2>Installation Guide</h2>
                    <h4>Prerequisites</h4>
                    <ul>
                        <li>XAMPP/WAMP installed</li>
                        <li>MySQL database server running</li>
                        <li>Web server configured</li>
                    </ul>

                    <h4>Installation Steps</h4>
                    <ol>
                        <li>Clone the repository to your web server directory</li>
                        <li>Import the database schema from <code>database/accounts.sql</code></li>
                        <li>Configure database connection in <code>php_action/db_connect.php</code></li>
                        <li>Set up virtual host (optional)</li>
                        <li>Configure file permissions</li>
                    </ol>
                </section>

                <section id="navigation">
                    <h2>Navigation Overview</h2>
                    <h4>Main Menu Structure</h4>
                    <ul>
                        <li>Accounts Dashboard
                            <ul>
                                <li>Account List</li>
                                <li>Create Account</li>
                                <li>Transaction History</li>
                            </ul>
                        </li>
                        <li>Reports
                            <ul>
                                <li>Balance Summary</li>
                                <li>Transaction Reports</li>
                            </ul>
                        </li>
                        <li>Settings
                            <ul>
                                <li>Account Types</li>
                                <li>User Permissions</li>
                            </ul>
                        </li>
                    </ul>
                </section>

                <section id="features">
                    <h2>Features</h2>
                    <h4>Account Management</h4>
                    <ul>
                        <li>Create new accounts with initial balance</li>
                        <li>Edit account details and type</li>
                        <li>Deactivate/reactivate accounts</li>
                        <li>View account history and transactions</li>
                    </ul>

                    <h4>Balance Management</h4>
                    <ul>
                        <li>Real-time balance updates</li>
                        <li>Transaction recording</li>
                        <li>Balance reconciliation</li>
                        <li>Transaction categorization</li>
                    </ul>

                    <h4>Reporting</h4>
                    <ul>
                        <li>Account statements</li>
                        <li>Transaction reports</li>
                        <li>Balance summaries</li>
                        <li>Audit trails</li>
                    </ul>
                </section>

                <section id="database">
                    <h2>Database Structure</h2>
                    <h4>Tables</h4>
                    <h5>1. accounts</h5>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Column</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>account_id</td>
                                <td>INT</td>
                                <td>Primary key, auto-increment</td>
                            </tr>
                            <tr>
                                <td>account_name</td>
                                <td>VARCHAR(255)</td>
                                <td>Name of the account</td>
                            </tr>
                            <tr>
                                <td>account_type</td>
                                <td>VARCHAR(50)</td>
                                <td>Type of account (e.g., Savings, Current)</td>
                            </tr>
                            <tr>
                                <td>current_balance</td>
                                <td>DECIMAL(10,2)</td>
                                <td>Current balance in the account</td>
                            </tr>
                            <tr>
                                <td>status</td>
                                <td>INT</td>
                                <td>Account status (1: Active, 0: Inactive)</td>
                            </tr>
                            <tr>
                                <td>created_at</td>
                                <td>TIMESTAMP</td>
                                <td>Account creation timestamp</td>
                            </tr>
                            <tr>
                                <td>updated_at</td>
                                <td>TIMESTAMP</td>
                                <td>Last update timestamp</td>
                            </tr>
                        </tbody>
                    </table>

                    <h5>2. account_transactions</h5>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Column</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>transaction_id</td>
                                <td>INT</td>
                                <td>Primary key, auto-increment</td>
                            </tr>
                            <tr>
                                <td>account_id</td>
                                <td>INT</td>
                                <td>Foreign key referencing accounts.account_id</td>
                            </tr>
                            <tr>
                                <td>transaction_type</td>
                                <td>VARCHAR(50)</td>
                                <td>Type of transaction (Credit/Debit)</td>
                            </tr>
                            <tr>
                                <td>amount</td>
                                <td>DECIMAL(10,2)</td>
                                <td>Transaction amount</td>
                            </tr>
                            <tr>
                                <td>description</td>
                                <td>TEXT</td>
                                <td>Transaction description</td>
                            </tr>
                            <tr>
                                <td>transaction_date</td>
                                <td>TIMESTAMP</td>
                                <td>Transaction timestamp</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="tutorials">
                    <h2>User Tutorials</h2>
                    <h4>Creating a New Account</h4>
                    <ol>
                        <li>Navigate to Accounts > Create Account</li>
                        <li>Fill in the required information:
                            <ul>
                                <li>Account Name</li>
                                <li>Account Type</li>
                                <li>Initial Balance</li>
                                <li>Status</li>
                    </ul>
                        </li>
                        <li>Click "Create Account" to save</li>
                    </ol>

                    <h4>Recording a Transaction</h4>
                    <ol>
                        <li>Open the account from the accounts list</li>
                        <li>Click "Add Transaction"</li>
                        <li>Enter transaction details:
                            <ul>
                                <li>Amount</li>
                                <li>Type (Credit/Debit)</li>
                                <li>Description</li>
                    </ul>
                        </li>
                        <li>Submit the transaction</li>
                    </ol>
                </section>

                <section id="api">
                    <h2>API Reference</h2>
                    <h4>Common Response Format</h4>
                    <pre>
{
    "success": boolean,
    "messages": string,
    "data": object (optional)
}</pre>

                    <h4>Error Handling</h4>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Error Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>400</td>
                                <td>Invalid request parameters</td>
                            </tr>
                            <tr>
                                <td>404</td>
                                <td>Account not found</td>
                            </tr>
                            <tr>
                                <td>409</td>
                                <td>Duplicate account name</td>
                            </tr>
                            <tr>
                                <td>500</td>
                                <td>Internal server error</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="faq">
                    <h2>Frequently Asked Questions</h2>
                    <h4>General Questions</h4>
                    <ul>
                        <li>
                            <strong>Q: How do I reset an account balance?</strong><br>
                            A: Navigate to the account settings and use the "Reset Balance" function with appropriate authorization.
                        </li>
                        <li>
                            <strong>Q: Can I change an account's type after creation?</strong><br>
                            A: Yes, edit the account and select a new type from the dropdown menu.
                        </li>
                        <li>
                            <strong>Q: How are transactions logged?</strong><br>
                            A: All transactions are automatically recorded with timestamps and user information.
                        </li>
                    </ul>
                </section>

                <section id="maintenance">
                    <h2>Maintenance Guide</h2>
                    <h4>Regular Maintenance Tasks</h4>
                    <ul>
                        <li>Database backups (daily recommended)</li>
                        <li>Log file cleanup (weekly)</li>
                        <li>Balance reconciliation (monthly)</li>
                        <li>System updates when available</li>
                    </ul>

                    <h4>Troubleshooting</h4>
                    <ul>
                        <li>Check error logs in <code>/logs</code> directory</li>
                        <li>Verify database connectivity</li>
                        <li>Validate file permissions</li>
                        <li>Contact support for unresolved issues</li>
                    </ul>
                </section>

                <section id="security">
                    <h2>Security Guidelines</h2>
                    <h4>Best Practices</h4>
                    <ul>
                        <li>Regular password updates</li>
                        <li>Use strong passwords</li>
                        <li>Enable two-factor authentication</li>
                        <li>Regular security audits</li>
                        <li>Monitor access logs</li>
                    </ul>

                    <h4>Access Control</h4>
                    <ul>
                        <li>Role-based permissions</li>
                        <li>IP-based access restrictions</li>
                        <li>Session management</li>
                        <li>Audit logging</li>
                    </ul>
                </section>

                <section id="glossary">
                    <h2>Glossary</h2>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Term</th>
                                <th>Definition</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Account Type</td>
                                <td>Classification of account (e.g., Savings, Current)</td>
                            </tr>
                            <tr>
                                <td>Transaction</td>
                                <td>Record of financial movement (credit or debit)</td>
                            </tr>
                            <tr>
                                <td>Balance</td>
                                <td>Current financial status of an account</td>
                            </tr>
                            <tr>
                                <td>Reconciliation</td>
                                <td>Process of matching account records with actual balances</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

