{
    "name": "pistocklnt/api",
    "description": "Production System API with JWT Authentication",
    "type": "project",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "cboden/ratchet": "^0.4.4",
        "firebase/php-jwt": "^6.0",
        "phpmailer/phpmailer": "^6.9",
        "react/event-loop": "^1.4",
        "react/socket": "^1.12",
        "tecnickcom/tcpdf": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "mockery/mockery": "^1.5",
        "fakerphp/faker": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Middleware\\": "includes/jwt/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text --coverage-html tests/coverage"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
