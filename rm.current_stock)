CREATE PROCEDURE calculate_production_requirements( IN p_order_number VARCHAR(50), IN p_product_id INT, IN p_target_quantity DECIMAL(10,2) ) BEGIN DECLARE v_error BOOLEAN DEFAULT FALSE; DECLARE v_error_message TEXT; DECLARE CONTINUE HANDLER FOR SQLEXCEPTION BEGIN SET v_error = TRUE; GET DIAGNOSTICS CONDITION 1 v_error_message = MESSAGE_TEXT; END; START TRANSACTION; INSERT INTO production_orders (order_number, product_id, target_quantity, status, start_date, expected_completion_date) VALUES (p_order_number, p_product_id, p_target_quantity, 'draft', CURRENT_DATE, DATE_ADD(CURRENT_DATE, INTERVAL 7 DAY)); SET @order_id = LAST_INSERT_ID(); INSERT INTO production_order_materials (production_order_id, material_id, required_quantity, consumed_quantity, last_consumed_quantity, status) SELECT @order_id, pb.material_id, p_target_quantity * pb.quantity_required * (1 + pb.wastage_percent/100), 0, 0, 'pending' FROM product_bom pb WHERE pb.product_id = p_product_id AND pb.status = 'active'; INSERT INTO material_reservations (material_id, production_order_id, reserved_quantity, status) SELECT pom.material_id, pom.production_order_id, pom.required_quantity, 'active' FROM production_order_materials pom WHERE pom.production_order_id = @order_id; IF EXISTS (SELECT 1 FROM production_order_materials pom JOIN raw_materials rm ON rm.id = pom.material_id WHERE pom.production_order_id = @order_id AND pom.required_quantity  THEN SET v_error = TRUE; SET v_error_message = 'Insufficient stock available for one or more materials'; END IF; INSERT INTO material_consumption_audit (production_order_id, material_id, previous_quantity, new_quantity, wastage_quantity, update_type, created_by) SELECT pom.production_order_id, pom.material_id, 0, 0, (pom.required_quantity * (pb.wastage_percent/100)), 'initial', 1 FROM production_order_materials pom JOIN product_bom pb ON pb.material_id = pom.material_id WHERE pom.production_order_id = @order_id; IF v_error THEN ROLLBACK; SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = v_error_message; ELSE COMMIT; INSERT INTO system_logs (log_type, message) VALUES ('PRODUCTION_CALCULATION', CONCAT('Production order ', p_order_number, ' created with calculated requirements')); END IF; END; 
